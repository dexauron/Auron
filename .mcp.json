{
  "mcpServers": {
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "n8n": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "n8n-mcp"
      ],
      "env": {
        "N8N_API_URL": "${N8N_API_URL}",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "yandex-cloud": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@theyahia/yandex-cloud-mcp"
      ],
      "env": {
        "YANDEX_CLOUD_TOKEN": "${YANDEX_CLOUD_TOKEN}",
        "YANDEX_CLOUD_FOLDER_ID": "${YANDEX_CLOUD_FOLDER_ID}"
      }
    }
  }
}