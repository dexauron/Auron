#!/bin/bash
# Установка «Учёта магазина» на Mac и Linux.
# Двойной клик в Finder запускает этот файл как программу.
#
# Программа никуда не «ставится» в обычном смысле: она вся лежит в одной
# папке. Установка — это копирование папки туда, где удобно владельцу.

set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE" || exit 1

echo
echo "  =========================================================="
echo "    УСТАНОВКА «УЧЁТА МАГАЗИНА»"
echo "  =========================================================="
echo
echo "  Программа вся лежит в одной папке. Установка — это"
echo "  копирование этой папки туда, где вам удобно."
echo

if [ ! -f "Учёт_магазина.html" ]; then
  echo "  Рядом с этим файлом нет «Учёт_магазина.html»."
  echo "  Запускайте «Установить.command» из папки программы, целиком."
  echo
  read -r -p "  Нажмите Enter, чтобы закрыть. " _
  exit 1
fi

# Куда класть. На Mac спрашиваем окном, на Linux — строкой:
# окна выбора папки там может не быть вовсе.
WHERE=""
if [ "$(uname)" = "Darwin" ]; then
  echo "  Сейчас откроется окно выбора папки."
  echo "  Выберите, КУДА положить программу: флешку или папку на компьютере."
  echo
  WHERE=$(osascript -e 'try
    POSIX path of (choose folder with prompt "Куда положить программу «Учёт магазина»")
  end try' 2>/dev/null)
else
  echo "  Напишите, КУДА положить программу."
  echo "  Например:  /media/flash    или    $HOME/Программы"
  echo
  read -r -p "  Путь: " WHERE
fi

WHERE="${WHERE%/}"
if [ -z "$WHERE" ]; then
  echo
  echo "  Папку не выбрали — ничего не сделано."
  echo
  read -r -p "  Нажмите Enter, чтобы закрыть. " _
  exit 0
fi

if [ ! -d "$WHERE" ]; then
  echo
  echo "  Папки «$WHERE» нет. Проверьте, правильно ли написан путь"
  echo "  и вставлена ли флешка."
  echo
  read -r -p "  Нажмите Enter, чтобы закрыть. " _
  exit 1
fi

DEST="$WHERE/Учёт магазина"

# Копировать папку саму в себя нельзя — получится матрёшка без конца.
if [ "$DEST" = "$HERE" ] || case "$DEST" in "$HERE"/*) true;; *) false;; esac; then
  echo
  echo "  Вы выбрали место внутри самой программы. Выберите другое."
  echo
  read -r -p "  Нажмите Enter, чтобы закрыть. " _
  exit 1
fi

echo
echo "  Копирую в: $DEST"
echo

mkdir -p "$DEST" || { echo "  Не получилось создать папку. Нет места или нет прав."; exit 1; }

# Выгрузки 1С не копируем: в них закупочные цены и телефоны поставщиков,
# и новая копия программы должна начинаться чистой.
bad=0
for f in * ; do
  [ "$f" = "Данные_1С_и_Excel" ] && continue
  cp -R "$f" "$DEST/" || bad=1
done

if [ "$bad" != "0" ]; then
  echo
  echo "  Скопировалось не всё. Чаще всего это значит: на диске нет места"
  echo "  или папка защищена от записи."
  echo
  read -r -p "  Нажмите Enter, чтобы закрыть. " _
  exit 1
fi

mkdir -p "$DEST/Данные_1С_и_Excel"
if [ -f "Данные_1С_и_Excel/ПОЛОЖИТЕ_СЮДА_ВЫГРУЗКИ.txt" ]; then
  cp "Данные_1С_и_Excel/ПОЛОЖИТЕ_СЮДА_ВЫГРУЗКИ.txt" "$DEST/Данные_1С_и_Excel/"
fi

chmod +x "$DEST/Установить.command" 2>/dev/null

echo "  =========================================================="
echo "    ГОТОВО"
echo "  =========================================================="
echo
echo "  Программа лежит здесь:"
echo "    $DEST"
echo
echo "  Открывать так: зайти в эту папку и открыть «Учёт_магазина.html»"
echo "  в Chrome, Edge или Яндекс.Браузере."
echo
echo "  ЧТО СДЕЛАТЬ ПЕРВЫМ ДЕЛОМ, ОДИН РАЗ:"
echo "    1. Запустите программу."
echo "    2. Слева откройте «Данные и копии»."
echo "    3. «Подключить папку» — укажите ЭТУ ЖЕ папку."
echo "    4. Там же «Куда класть вторую копию» — укажите ДРУГОЕ место:"
echo "       вторую флешку или папку на компьютере. Если эта флешка"
echo "       потеряется или сломается, база останется во второй папке."
echo
read -r -p "  Нажмите Enter, чтобы закрыть. " _
