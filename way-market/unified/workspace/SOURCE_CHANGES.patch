+test('extended product and profile save atomically with stable ID, core compatibility and history',()=>{const group=save(cmd('group',{name:'Молочное',parentId:null,active:true})),packId=randomUUID(),barcode='000123456';const p=product({groupId:group.id,article:'АРТ-1',cashCode:'00101',brand:'Бренд',unit:'шт',sizeKind:'volume',sizeValue:900,fat:250,packages:[{id:packId,label:'Коробка',quantity:12000}],barcodes:[{code:barcode,packageId:null},{code:'000123457',packageId:packId}]},{barcode});const got=read().products.find(x=>x.id===p.id);assert.equal(got.profile.packages[0].quantity,12000);assert.equal(got.profile.cashCode,'00101');assert.equal(w.products(employee.token).find(x=>x.id===p.id).barcode,barcode);assert.equal(w.catalogHistory(admin.token,p.id).length,1);assert.throws(()=>update(p,{weighted:true,unit:'шт'}));assert.equal(read().products.find(x=>x.id===p.id).version,1);});
