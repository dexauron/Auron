__pycache__/
# Личные настройки Claude Code игнорируем, но общее для проекта храним в
# репозитории: скилы, хуки (защита от отката папки) и settings.json, который
# эти хуки включает. Без этого защита жила бы только на диске контейнера —
# и пропала бы при первом же откате, от которого должна защищать.
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
node_modules/
package-lock.json
package.json

# Витрину каталога (catalog/data/) публикует само приложение в деплой-ветку —
# в рабочей ветке её не храним.
catalog/data/
