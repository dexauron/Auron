__pycache__/

# Настройки Claude Code: храним в репозитории только конфиг и лёгкие навыки.
# Личные и временные файлы Claude, а также тяжёлый gstack (~23 МБ)
# ставятся локально скриптом scripts/setup-claude-skills.sh
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/hooks/
.claude/settings.local.json
.claude/skills/gstack/

# Ключи к сервисам — в репозиторий не кладём никогда
.env
.env.*
!.env.example

node_modules/
package-lock.json
package.json

# Выгрузки 1С магазина не публикуем: репозиторий открытый,
# а в этих файлах цены, себестоимость и телефоны поставщиков.
Учёт-магазина/Данные_1С_и_Excel/*
!Учёт-магазина/Данные_1С_и_Excel/ПОЛОЖИТЕ_СЮДА_ВЫГРУЗКИ.txt

# Собранный архив для владельца. Его пересобирают из этой же папки перед
# каждой отправкой, поэтому в репозитории он не нужен: это копия того, что
# и так лежит рядом, только на мегабайт тяжелее с каждой пересборкой.
Учёт-магазина.zip
